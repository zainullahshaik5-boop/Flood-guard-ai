# FLOOD GUARD AI - Environment Variables Template
# System automatically runs in high-fidelity DEMO MODE if keys are absent.

# GEMINI_API_KEY: Optional - For live server-side multimodal image reasoning and dynamic assistant Q&A.
# If omitted, deterministic rule-based ML & domain emergency heuristics are used seamlessly.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted (injected automatically in production)
APP_URL="http://localhost:3000"

# GOOGLE MAPS API KEY (Optional):
# For live Google Maps satellite & terrain tile overlay.
# When not set, the platform uses its built-in interactive topographic SVG/Canvas contour GIS engine.
VITE_GOOGLE_MAPS_API_KEY=""

# FIREBASE CONFIGURATION (Optional):
# For remote persistent sync across physical dispatch teams.
# When not set, browser-based secure local state and offline IndexedDB/LocalStorage sync are used.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
